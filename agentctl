// ============================ task create ============================

function warnIfInPlatformWorktree() {
  const cwd = normalizePath(process.cwd());
  for (const row of buildPlatforms()) {
    if (!row.worktree) continue;
    if (isUnder(cwd, row.worktree)) {
      warn(`当前目录位于平台 worktree（${row.id}：${row.worktree}）内。平台 worktree 只做 integration / review / test / release，不要在平台 worktree 内开发；agent 开发目录必须是任务 worktree（${WORKTREE_ROOT}/<platform>/<task-id>）。`);
    }
  }
}

function cmdTaskCreate(argv) {
  const { vals, flags } = parseFlags(argv, {
    value: ['--platform', '--agent', '--task', '--title', '--objective', '--requirements', '--allowed-paths', '--feature', '--parent', '--test-command', '--timeout'],
    bool: ['--start', '--allow-overlap', '--dry-run'],
  });
  const platformName = vals['--platform'];
  const agent = vals['--agent'];
  const title = vals['--title'];
  if (!platformName) usageError('缺少 --platform');
  if (!agent) usageError('缺少 --agent');
  if (!title && !vals['--task']) usageError('缺少 --title（或显式 --task）');
  validateSlug('agent 名', agent);
  if (vals['--task']) validateSlug('task id', vals['--task']);

  const objective = vals['--objective'] || title || vals['--task'];
  const requirements = splitList(vals['--requirements']);
  const allowed = parseAllowedPaths(vals['--allowed-paths']);
  const row = resolvePlatform(platformName);
  const baseCommit = revParse(row.branch);
  if (!baseCommit) die(`平台分支不存在：${row.branch}`);
  const wtPathPreview = path.join(WORKTREE_ROOT, row.id, vals['--task'] || '<auto>');

  // —— 创建前的检查：平台状态、当前目录、已有任务 scope 重叠 ——
  if (worktreeState(row.worktree) === 'dirty') {
    warn(`平台 worktree 存在未提交改动（${row.worktree}）：本任务基于 ${row.branch} 的 HEAD（${baseCommit.slice(0, 8)}），不含这些改动；agentctl 不会改动、清理或丢弃该 worktree 的任何内容。`);
  }
  warnIfInPlatformWorktree();
  warnIfInTaskWorktree();
  if (WORKTREE_ROOT_INSIDE) {
    warn(`worktree_root（${WORKTREE_ROOT}）位于仓库主 checkout 内部：任务 worktree 会污染主 checkout 的 git status，建议在 .agents/config/platforms.json 配置为仓库外的同级目录。`);
  }

  const conflicts = findScopeConflicts(row.id, allowed, vals['--task'] || '');
  const overlaps = conflicts.filter((c) => c.overlap);
  const undecidable = conflicts.filter((c) => !c.overlap);
  if (overlaps.length > 0 && !flags.has('--allow-overlap')) {
    const body = overlaps
      .map((c) => `Task:   ${c.task.id}\nAgent:  ${c.task.agent}\nStatus: ${c.task.status}\nScope:  ${c.task.allowed_paths.join(', ')}\n冲突:   ${c.reason}`)
      .join('\n\n');
    die(`已有未结束任务占用重叠 scope：\n\n${body}\n\n处理方式：复用该任务（agentctl task start ${overlaps[0].task.id}）、调整 scope，或确认确实需要并行时加 --allow-overlap。`);
  }
  for (const c of overlaps) {
    warn(`scope 与 ${c.task.id}（${c.task.agent}）重叠：${c.reason}——已按 --allow-overlap 继续，冲突将在 integration 阶段由 Git 暴露。`);
  }
  for (const c of undecidable) {
    warn(`无法判定与 ${c.task.id}（${c.task.agent}）的 scope 重叠：${c.reason}`);
  }

  // task id 生成 + 注册表写入 + worktree 创建在同一临界区内完成，避免并发 create 撞名
  const result = withRegistryLock(() => {
    const taskId = vals['--task'] || nextTaskId(row.id, title);
    const taskBranch = `${BRANCH_PREFIX}/${agent}/${taskId}`;
    const wtPath = path.join(WORKTREE_ROOT, row.id, taskId);
    const file = taskPath(taskId);

    if (isFile(file)) die(`任务已存在：${taskId}（${file}）`);
    if (branchExists(taskBranch)) die(`分支已存在：${taskBranch}——先清理（agentctl task remove ${taskId} --force）或换 task id`);
    if (fs.existsSync(wtPath)) die(`任务 worktree 目录已存在：${wtPath}——先删除或换 task id`);
    if (isUnder(wtPath, row.worktree)) die(`任务 worktree 不能位于平台 worktree 内：${wtPath}`);

    const task = {
      id: taskId,
      uuid: crypto.randomUUID(),
      schema_version: 1,
      title: title || taskId,
      objective,
      requirements,
      platform: row.id,
      agent,
      base_branch: row.branch,
      base_commit: baseCommit,
      task_branch: taskBranch,
      worktree: wtPath,
      worktree_rel: '',
      status: 'active',
      allowed_paths: allowed,
      feature: vals['--feature'] || null,
      parent_task: vals['--parent'] || null,
      test_command: vals['--test-command'] || null,
      test_timeout: parseTimeoutArg(vals['--timeout']),
      created_at: new Date().toISOString(),
      updated_at: new Date().toISOString(),
      finished_at: null,
      finished_commit: null,
      merged_at: null,
      merged_into: null,
      merged_commit: null,
    };

    if (flags.has('--dry-run')) return { task, created: false };

    fs.mkdirSync(path.dirname(wtPath), { recursive: true });
    fs.mkdirSync(TASKS_DIR, { recursive: true });
    fs.mkdirSync(STATE_DIR, { recursive: true });

    const add = git(['-C', ROOT, 'worktree', 'add', '-b', taskBranch, wtPath, baseCommit]);
    if (add.status !== 0) die(`创建任务 worktree 失败：${wtPath}\n${(add.stderr || '').trim()}`);
    task.worktree = normalizePath(wtPath);
    task.worktree_rel = relToRoot(task.worktree);

    const contextFile = writeTaskContext(task);
    writeTask(task);
    return { task, created: true, contextFile };
  });

  const task = result.task;
  if (!result.created) {
    note('[dry-run] 将创建（未改动任何文件）：');
    note('');
    note(`Platform:  ${row.id}（${relToRoot(row.worktree)} @ ${row.branch}）`);
    note(`Task ID:   ${task.id}`);
    note(`Branch:    ${task.task_branch}`);
    note(`Worktree:  ${wtPathPreview}`);
    note('');
    note(JSON.stringify(task, null, 2));
    const planned = buildRunnerCommand(task);
    if (planned.ok) note(`\n[dry-run] Worker 启动命令：${planned.command} ${planned.args.map(shellQuote).join(' ')}`);
    else note(`\n[dry-run] 无法自动启动 Worker：${planned.reason}`);
    return;
  }
  const contextFile = result.contextFile;

  note('Task created.');
  note('');
  note('Platform:');
  note(`  ${row.id}  (${relToRoot(row.worktree)} @ ${row.branch})`);
  note('');
  note('Agent:');
  note(`  ${agent}`);
  note('');
  note('Base:');
  note(`  ${row.branch} @ ${baseCommit.slice(0, 8)}`);
  note('');
  note('Task Branch:');
  note(`  ${task.task_branch}`);
  note('');
  note('Worktree:');
  note(`  ${task.worktree}`);
  note('');
  note('Task Context:');
  note(`  ${contextFile}`);
  note('');
  note('Allowed paths:');
  note(allowedBlock(allowed));
  note('');
  note('Test command:');
  note(`  ${effectiveTestCommand(task) || '（未配置：finish 时跳过测试检查）'}`);
  note('');
  note('Check scope:');
  note(`  ${SELF} task check ${task.id}`);
  note('');

  const runner = buildRunnerCommand(task);
  if (flags.has('--start')) {
    startWorker(task, runner);
    return;
  }
  note('Start Worker:');
  if (runner.ok) {
    note(`  ${SELF} task start ${task.id}          # 自动启动 ${task.agent}（${runner.command}）`);
  }
  note('');
  note(`  cd ${task.worktree}`);
  note(`  ${task.agent}`);
  note('');
  if (!runner.ok) note(`（自动启动降级：${runner.reason}）`);
  note(`平台 worktree（${relToRoot(row.worktree)}）只做 integration / review / release，勿在其中开发。`);
}

function warnIfInTaskWorktree() {
  const cwd = normalizePath(process.cwd());
  const t = taskForWorktree(cwd);
  if (t) warn(`当前目录是任务 worktree（${t.id}）：如需在该任务内继续开发请直接开工；若要创建新任务，请回到仓库根或使用 -C 指定。`);
}

function startWorker(task, runner) {
  if (!runner.ok) {
    note('无法自动启动 Worker，已降级为手工启动：');
    note('');
    note(`  cd ${task.worktree}`);
    note(`  ${task.agent}`);
    note('');
    note(`原因：${runner.reason}`);
    return 0;
  }
  if (DRY_RUN) {
    note(`[dry-run] ${runner.command} ${runner.args.map(shellQuote).join(' ')}`);
    return 0;
  }
  note(`启动 Worker：${runner.command} ${runner.args.map(shellQuote).join(' ')}`);
  note('');
  const res = spawnSync(runner.command, runner.args, { cwd: task.worktree, stdio: 'inherit', env: process.env });
  return res.status === null ? 1 : res.status;
}

function shellQuote(s) {
  return /^[A-Za-z0-9_./:=@+-]+$/.test(s) ? s : `'${s.replaceAll("'", "'\\''")}'`;
}

function taskForWorktree(wt) {
  const abs = normalizePath(wt);
  for (const id of listTasks()) {
    const t = readTask(id);
    if (t.worktree === abs) return t;
  }
  return null;
}

// ============================ task list / show / current ============================

function cmdTaskList(argv) {
  const { vals } = parseFlags(argv, { value: ['--platform', '--agent', '--status', '--feature'] });
  const filt = {
    platform: vals['--platform'] || '',
    agent: vals['--agent'] || '',
    status: vals['--status'] || '',
    feature: vals['--feature'] || '',
  };
  const tasks = listTasks()
    .map((id) => readTask(id))
    .filter((t) => (!filt.platform || t.platform === filt.platform)
      && (!filt.agent || t.agent === filt.agent)
      && (!filt.status || t.status === filt.status)
      && (!filt.feature || (t.feature || '') === filt.feature));

  if (JSON_OUT) {
    note(JSON.stringify(tasks.map(({ file, ...rest }) => rest), null, 2));
    return;
  }
  if (tasks.length === 0) {
    note('（无匹配任务）');
    return;
  }
  printTable(['ID', 'PLATFORM', 'AGENT', 'STATUS'], tasks.map((t) => [t.id, t.platform, t.agent, t.status]));
}

function taskLiveInfo(task) {
  const wtState = worktreeState(task.worktree);
  const hasBranch = branchExists(task.task_branch);
  const ahead = task.base_commit ? revListCount(`${task.base_commit}..refs/heads/${task.task_branch}`) : 0;
  const tip = hasBranch ? git(['-C', ROOT, 'rev-parse', `refs/heads/${task.task_branch}`]).stdout.trim() : '';
  const platRow = buildPlatforms().find((r) => r.id === task.platform);
  let platNote = '';
  let merged = 'no';
  if (platRow && platRow.state === 'ok') {
    platNote = `${relToRoot(platRow.worktree)} @ ${platRow.branch}`;
    // 只有任务分支确实领先 base（有本任务的提交）时才谈"已并入"
    if (ahead > 0 && tip && isAncestor(tip, platRow.branch)) merged = `yes (已并入 ${platRow.branch})`;
  } else if (platRow) {
    platNote = `平台不可用：${platRow.state}`;
  }
  return { wtState, hasBranch, ahead, merged, platNote, tip };
}

function printNext(task) {
  const map = {
    created: `Next: ${SELF} task start ${task.id}（把 Worker 接到该任务）`,
    active: `Next: 在任务 worktree 内完成开发并提交，然后 ${SELF} task finish ${task.id}`,
    ready: `Next: ${SELF} task merge-check ${task.id} → ${SELF} task integrate ${task.id}`,
    blocked: `Next: 解除阻塞后 ${SELF} task set-status ${task.id} active`,
    conflict: `Next: 解决平台分支上的合并冲突，然后 ${SELF} task integrate ${task.id} 收尾`,
    integrating: `Next: ${SELF} task integrate ${task.id} 收尾合并`,
    merged: `Next: ${SELF} task remove ${task.id}（工作区干净且已并入平台分支时回收）`,
    failed: `Next: 排查失败原因后 ${SELF} task set-status ${task.id} active 重试，或 ${SELF} task remove ${task.id} --force`,
    cancelled: `Next: ${SELF} task remove ${task.id} --force（回收工作区与分支）`,
  };
  note(map[task.status] || `Next: 状态未知（${task.status}），检查任务元数据`);
}

function cmdTaskShow(argv) {
  const { positional } = parseFlags(argv);
  const id = positional[0];
  if (!id) usageError('task show 需要 task id');
  const task = readTask(id);
  const live = taskLiveInfo(task);

  if (JSON_OUT) {
    const { file, ...rest } = task;
    note(JSON.stringify({
      ...rest,
      live_worktree: live.wtState,
      live_branch: live.hasBranch,
      commits_ahead: live.ahead,
      merged: live.merged,
      task_context: taskContextPath(task.worktree),
      task_context_exists: isFile(taskContextPath(task.worktree)),
    }, null, 2));
    return;
  }

  note(`Task:       ${task.id}`);
  note(`UUID:       ${task.uuid || '—'}`);
  note(`Title:      ${task.title}`);
  note(`Platform:   ${task.platform}${live.platNote ? `  (${live.platNote})` : ''}`);
  note(`Agent:      ${task.agent}`);
  note(`Task Branch: ${task.task_branch}`);
  note(`Worktree:   ${task.worktree}`);
  note(`Base:       ${task.base_branch} @ ${(task.base_commit || '').slice(0, 8)}`);
  note(`Status:     ${task.status}`);
  note(`Feature:    ${task.feature || '—'}`);
  note(`Parent:     ${task.parent_task || '—'}`);
  note(`Created:    ${task.created_at}`);
  note(`Updated:    ${task.updated_at || '—'}`);
  if (task.finished_commit) note(`Finished:   ${task.finished_commit.slice(0, 8)}`);
  if (task.merged_into) note(`Merged:     ${(task.merged_commit || '').slice(0, 8)} → ${task.merged_into}`);
  note(`Test cmd:   ${effectiveTestCommand(task) || '—'}`);
  note('Allowed paths:');
  note(allowedBlock(task.allowed_paths));
  if (task.requirements.length) {
    note('Requirements:');
    note(task.requirements.map((r) => `  - ${r}`).join('\n'));
  }
  note('Live state:');
  note(`  worktree:      ${live.wtState}`);
  note(`  branch:        ${live.hasBranch ? 'yes' : 'no'}`);
  note(`  commits ahead: ${live.ahead}`);
  note(`  merged:        ${live.merged}`);
  note(`  task context:  ${isFile(taskContextPath(task.worktree)) ? 'yes' : 'no'}（${taskContextPath(task.worktree)}）`);
  note('');
  printNext(task);
}

// 当前 worktree 是否处于某个任务中（Worker Mode）还是协调模式（Coordinator Mode）
function cmdTaskCurrent(argv) {
  parseFlags(argv);
  const cwd = normalizePath(process.cwd());
  const task = taskForWorktree(cwd);
  const contextFile = taskContextPath(cwd);
  const hasContext = isFile(contextFile);
  const mode = task && hasContext ? 'worker' : 'coordinator';
  if (JSON_OUT) {
    note(JSON.stringify({ mode, cwd, task: task ? task.id : null, task_context: hasContext ? contextFile : null }, null, 2));
    return;
  }
  if (mode === 'worker') {
    note(`Mode: worker（当前 worktree 属于任务 ${task.id}，任务上下文 ${contextFile}）`);
    note(`Platform: ${task.platform}　Agent: ${task.agent}　Status: ${task.status}`);
    note(`Scope: ${task.allowed_paths.length ? task.allowed_paths.join(', ') : '未限定'}`);
    note('');
    note(`下一步：在 ${cwd} 内实现并提交，然后 ${SELF} task finish ${task.id}`);
    return;
  }
  note(`Mode: coordinator（当前 worktree 没有任务上下文，目录 ${cwd}）`);
  note('收到实现类需求时：先 agentctl platform list 与 agentctl task list，判断平台与 scope 冲突，再 agentctl task create 建任务 worktree。');
}

// ============================ task check ============================

function cmdTaskCheck(argv) {
  const { positional } = parseFlags(argv);
  const id = positional[0];
  if (!id) usageError('task check 需要 task id');
  const task = readTask(id);
  if (!isDir(task.worktree)) die(`任务 worktree 不存在：${task.worktree}`);
  if (!gitQuiet(['-C', task.worktree, 'rev-parse', '--git-dir'])) {
    die(`任务 worktree 不是有效 git 工作区：${task.worktree}`);
  }

  const changed = collectChanges(task.worktree, task.base_commit);
  const unexpected = scopeUnexpected(task.allowed_paths, changed);
  const ok = unexpected.length === 0;

  if (JSON_OUT) {
    note(JSON.stringify({ id: task.id, ok, allowed_paths: task.allowed_paths, changed, unexpected }, null, 2));
    process.exit(ok ? 0 : 1);
  }

  if (ok) {
    note(`Task check: ${task.id}`);
    note('Allowed paths:');
    note(allowedBlock(task.allowed_paths));
    note(`Changed files: ${changed.length}`);
    note('Result: OK — 改动均在 allowed_paths 内');
    return;
  }

  process.stderr.write('ERROR:\nTask modified files outside allowed scope.\n\n');
  process.stderr.write(`Task:\n  ${task.id}\n\n`);
  process.stderr.write(`Allowed:\n${allowedBlock(task.allowed_paths)}\n\n`);
  process.stderr.write(`Unexpected files:\n${unexpected.map((u) => `  ${u}`).join('\n')}\n\n`);
  process.stderr.write(`Changed files (${changed.length}):\n${changed.map((c) => `  ${c}`).join('\n')}\n`);
  process.exit(1);
}

// ============================ task diff ============================

function cmdTaskDiff(argv) {
  const { flags, positional } = parseFlags(argv, { bool: ['--stat', '--name-only', '--working'] });
  const id = positional[0];
  if (!id) usageError('task diff 需要 task id');
  const task = readTask(id);
  if (!isDir(task.worktree)) die(`任务 worktree 不存在：${task.worktree}`);

  const opts = [];
  if (flags.has('--stat')) opts.push('--stat');
  if (flags.has('--name-only')) opts.push('--name-only');

  const base = git(['-C', task.worktree, 'diff', ...opts, `${task.base_commit}..HEAD`]);
  process.stdout.write(base.stdout);
  if (flags.has('--working')) {
    note('');
    note('--- 工作区未提交改动（相对 HEAD）---');
    process.stdout.write(git(['-C', task.worktree, 'diff', ...opts, 'HEAD']).stdout);
    if (git(['-C', task.worktree, 'diff', '--cached', '--name-only']).stdout.trim() !== '') {
      note('');
      note('--- 已暂存（diff --cached）---');
      process.stdout.write(git(['-C', task.worktree, 'diff', '--cached', ...opts]).stdout);
    }
  } else if (git(['-C', task.worktree, 'status', '--porcelain']).stdout.trim() !== '') {
    note('');
    note('（任务 worktree 存在未提交改动；用 --working 查看）');
  }
}

// ============================ task finish ============================

function cmdTaskFinish(argv) {
  const { vals, flags, positional } = parseFlags(argv, { value: ['--test-command', '--timeout'], bool: ['--no-test'] });
  const id = positional[0];
  if (!id) usageError('task finish 需要 task id');
  const task = readTask(id);
  const failures = [];

  note(`Task finish: ${task.id}`);
  note('');

  // [1/5] worktree 与分支
  let ok1 = true;
  const wtState = worktreeState(task.worktree);
  if (wtState === 'missing') {
    ok1 = false;
    failures.push(`任务 worktree 不存在：${task.worktree}`);
  } else if (!branchExists(task.task_branch)) {
    ok1 = false;
    failures.push(`任务分支不存在：${task.task_branch}`);
  } else {
    const headRef = currentBranch(task.worktree);
    if (headRef !== task.task_branch) {
      ok1 = false;
      failures.push(`任务 worktree 当前检出分支是 ${headRef}，期望 ${task.task_branch}`);
    }
  }
  note(`  [1/5] worktree 与分支：${okFail(ok1)}`);

  // [2/5] 无未提交改动
  const dirty = isDir(task.worktree) && git(['-C', task.worktree, 'status', '--porcelain']).stdout.trim() !== '';
  if (dirty) failures.push('任务 worktree 存在未提交改动（含未跟踪文件）：agentctl 不会丢弃它们，请先提交或清理');
  note(`  [2/5] 无未提交改动：${okFail(!dirty)}`);

  // [3/5] 改动范围
  const changed = collectChanges(task.worktree, task.base_commit);
  const unexpected = scopeUnexpected(task.allowed_paths, changed);
  for (const u of unexpected) failures.push(`越界文件：${u}`);
  note(`  [3/5] allowed_paths 范围（${changed.length} 个改动文件）：${okFail(unexpected.length === 0)}`);

  // [4/5] 至少一个 commit
  const ahead = task.base_commit ? revListCount(`${task.base_commit}..refs/heads/${task.task_branch}`) : 0;
  if (ahead <= 0) failures.push(`任务分支相对 base（${(task.base_commit || '').slice(0, 8)}）没有任何 commit`);
  note(`  [4/5] 提交数（base 之后）：${ahead}（${okFail(ahead > 0)}）`);

  // [5/5] 测试
  let testState;
  let testCommand = '';
  if (flags.has('--no-test')) {
    testState = 'skipped（--no-test）';
  } else {
    testCommand = vals['--test-command'] !== undefined ? vals['--test-command'] : effectiveTestCommand(task);
    if (!testCommand) {
      testState = 'skipped（未配置测试命令）';
    } else {
      const timeoutSec = vals['--timeout'] !== undefined ? parseTimeoutArg(vals['--timeout']) : effectiveTestTimeout(task);
      note(`  [5/5] 测试：${testCommand}${timeoutSec ? `（超时 ${timeoutSec}s）` : ''}`);
      note('');
      const spawnOpts = { cwd: task.worktree, stdio: 'inherit', env: process.env };
      if (timeoutSec) {
        spawnOpts.timeout = timeoutSec * 1000;
        spawnOpts.killSignal = 'SIGTERM';
      }
      const res = spawnSync('bash', ['-c', testCommand], spawnOpts);
      const timedOut = Boolean(timeoutSec) && Boolean(res.error) && res.error.code === 'ETIMEDOUT';
      const rc = res.status === null ? 1 : res.status;
      note('');
      if (timedOut) {
        testState = `FAIL（${testCommand}，超时 ${timeoutSec}s 被终止）`;
        failures.push(`测试超时（${timeoutSec}s）：${testCommand}`);
      } else if (rc === 0) {
        testState = `OK（${testCommand}）`;
      } else {
        testState = `FAIL（${testCommand}，退出码 ${rc}）`;
        failures.push(`测试未通过：${testCommand}（退出码 ${rc}）`);
      }
    }
  }
  note(`  [5/5] 测试：${testState}`);
  note('');

  if (failures.length > 0) {
    process.stderr.write('ERROR:\nfinish 被拒绝：未修改任何文件、未丢弃任何改动。\n\n');
    process.stderr.write(`Failures:\n${failures.map((f) => `  ${f}`).join('\n')}\n`);
    process.exit(1);
  }

  const tip = git(['-C', ROOT, 'rev-parse', `refs/heads/${task.task_branch}`]).stdout.trim();
  const updated = updateTask(task.id, {
    status: 'ready',
    finished_at: new Date().toISOString(),
    finished_commit: tip,
  });

  const summary = {
    task: updated.id,
    platform: updated.platform,
    agent: updated.agent,
    task_branch: updated.task_branch,
    worktree: updated.worktree,
    changed_files: changed,
    tests: testState,
    commit: tip,
    commit_short: tip.slice(0, 8),
    status: 'ready for integration',
  };
  if (JSON_OUT) {
    note(JSON.stringify(summary, null, 2));
    return;
  }

  note('Task completed.');
  note('');
  note(`Task:      ${summary.task}`);
  note(`Platform:  ${summary.platform}`);
  note(`Agent:     ${summary.agent}`);
  note(`Branch:    ${summary.task_branch}`);
  note(`Worktree:  ${summary.worktree}`);
  note('Changed files:');
  note(changed.length ? changed.map((c) => `  ${c}`).join('\n') : '  （无）');
  note(`Tests:     ${summary.tests}`);
  note(`Commit:    ${summary.commit_short}`);
  note(`Status:    ${summary.status}`);
  note('');
  note('Next:');
  note(`  ${SELF} task merge-check ${task.id}`);
  note(`  ${SELF} task integrate ${task.id}`);
}

// ============================ task set-status ============================

function cmdTaskSetStatus(argv) {
  const { vals, positional } = parseFlags(argv, { value: ['--note'] });
  const id = positional[0];
  const status = positional[1];
  if (!id || !status) usageError('task set-status 需要 <task id> <status>');
  if (!STATUSES.includes(status)) die(`非法状态：${status}（合法值：${STATUSES.join(' / ')}）`);
  const task = readTask(id);
  const updated = updateTask(id, { status, status_note: vals['--note'] || null });
  note(`任务 ${task.id} 状态：${task.status} → ${updated.status}${vals['--note'] ? `（${vals['--note']}）` : ''}`);
}

// ============================ task update-base ============================

// 平台分支随其他任务 integrate 不断前进后，把新提交合并进任务分支并刷新
// base_commit，让 scope 检查与 finish 门禁始终对着正确的基点。
// 冲突语义与 integrate 一致：保留进行中的 merge，解决后重跑收尾。
function cmdTaskUpdateBase(argv) {
  const { flags, positional } = parseFlags(argv, { bool: ['--dry-run'] });
  const id = positional[0];
  if (!id) usageError('task update-base 需要 task id');
  const task = readTask(id);
  if (task.status === 'merged') {
    die(`任务已并入 ${task.merged_into || '平台分支'}：无需 update-base（回收用 ${SELF} task remove ${id}）`);
  }
  if (task.status === 'conflict' || task.status === 'integrating') {
    die(`任务处于集成阶段（${task.status}）：先在平台 worktree 收尾或放弃该 merge，再做 update-base`);
  }
  if (!isDir(task.worktree)) die(`任务 worktree 不存在：${task.worktree}`);
  if (!branchExists(task.task_branch)) die(`任务分支不存在：${task.task_branch}`);
  const row = resolvePlatform(task.platform);
  const platformTip = revParse(row.branch);
  if (!platformTip) die(`平台分支不存在：${row.branch}`);

  const headRef = currentBranch(task.worktree);
  if (headRef !== task.task_branch) {
    die(`任务 worktree 当前检出分支是 ${headRef}，期望 ${task.task_branch}`);
  }
  const dirty = git(['-C', task.worktree, 'status', '--porcelain']).stdout.trim() !== '';
  if (dirty && !mergeInProgress(task.worktree)) {
    die(`任务 worktree 存在未提交改动：先提交后再 update-base（agentctl 不会丢弃任何内容）\n${task.worktree}`);
  }

  note(`Task update-base: ${row.branch} → ${task.task_branch}`);
  note('');

  if (mergeInProgress(task.worktree)) {
    // 续做上次 update-base 的冲突合并
    const mergeHead = git(['-C', task.worktree, 'rev-parse', 'MERGE_HEAD']).stdout.trim();
    if (mergeHead !== platformTip) {
      die(`存在其他进行中的 merge（MERGE_HEAD=${mergeHead.slice(0, 8)}，当前平台 HEAD=${platformTip.slice(0, 8)}）：请先收尾，或 cd ${task.worktree} && git merge --abort 后重试`);
    }
    const unmerged = lines(git(['-C', task.worktree, 'diff', '--name-only', '--diff-filter=U']).stdout);
    if (unmerged.length > 0) {
      note('上次 update-base 的 merge 仍在进行，以下文件冲突尚未解决：');
      note(unmerged.map((f) => `  ${f}`).join('\n'));
      note('');
      note(`解决后：cd ${task.worktree} && git add <files>，再执行 ${SELF} task update-base ${id} 收尾。`);
      note(`放弃本次基点更新：cd ${task.worktree} && git merge --abort`);
      process.exit(1);
    }
    note('冲突已解决，收尾基点更新合并…');
    const commit = git(['-C', task.worktree, 'commit', '--no-edit']);
    if (commit.status !== 0) die(`收尾合并提交失败（cd ${task.worktree} && git status 查看）`);
    finishUpdateBase(task, platformTip, flags.has('--dry-run'));
    return;
  }

  const behind = task.base_commit ? revListCount(`${task.base_commit}..refs/heads/${row.branch}`) : 0;
  const ahead = task.base_commit ? revListCount(`${task.base_commit}..refs/heads/${task.task_branch}`) : 0;
  if (flags.has('--dry-run')) {
    note(`[dry-run] 平台分支领先任务基点 ${behind} 个提交；任务分支领先 ${ahead} 个提交。`);
    note(`[dry-run] 将执行：cd ${task.worktree} && git merge --no-edit ${row.branch}`);
    return;
  }
  if (behind === 0) {
    note(`已基于 ${row.branch} 最新提交（${platformTip.slice(0, 8)}）：无需更新。`);
    return;
  }
  note(`平台分支领先任务基点 ${behind} 个提交（任务分支领先 ${ahead} 个），合并中…`);
  const res = git(['-C', task.worktree, 'merge', '--no-edit', row.branch]);
  if (res.status !== 0) {
    if (mergeInProgress(task.worktree)) {
      const conflicted = lines(git(['-C', task.worktree, 'diff', '--name-only', '--diff-filter=U']).stdout);
      note('');
      note('update-base CONFLICT：任务 worktree 中保留了进行中的 merge（未回退、未丢弃任何内容）。');
      note('');
      note('Conflicted files:');
      note(conflicted.map((f) => `  ${f}`).join('\n'));
      note('');
      note(`解决后：cd ${task.worktree} && git add <files>，再执行 ${SELF} task update-base ${id} 收尾。`);
      note(`放弃本次基点更新：cd ${task.worktree} && git merge --abort`);
      process.exit(1);
    }
    die(`merge 失败（cd ${task.worktree} && git status 查看）\n${(res.stderr || res.stdout).trim()}`);
  }
  finishUpdateBase(task, platformTip, false);
}

function finishUpdateBase(task, newBase, dryRun) {
  if (dryRun) return;
  // 基点移动后以新基点复核 scope：只提示，不拦截（finish 才是门禁）
  const changed = collectChanges(task.worktree, newBase);
  const unexpected = scopeUnexpected(task.allowed_paths, changed);

  const demoted = task.status === 'ready';
  const updated = updateTask(task.id, demoted
    ? { base_commit: newBase, status: 'active', finished_at: null, finished_commit: null }
    : { base_commit: newBase });

  if (JSON_OUT) {
    note(JSON.stringify({
      id: updated.id,
      platform: updated.platform,
      task_branch: updated.task_branch,
      base_branch: updated.base_branch,
      base_commit: newBase,
      status: updated.status,
      status_demoted: demoted,
      changed_files: changed.length,
      unexpected,
    }, null, 2));
    return;
  }

  note('');
  note(`基点已更新：${updated.base_branch} @ ${newBase.slice(0, 8)}（${updated.task_branch}）。`);
  note(`相对新基点的改动文件：${changed.length} 个${unexpected.length === 0 ? '，均在 allowed_paths 内' : ''}。`);
  if (unexpected.length > 0) {
    warn('以下文件越出 allowed_paths（update-base 不拦截，但 task finish 会拒绝）：');
    process.stderr.write(`${unexpected.map((u) => `  ${u}`).join('\n')}\n`);
  }
  if (demoted) {
    note('状态 ready → active：基点已变更，需重新 finish 后再 integrate。');
  }
  note('');
  printNext(updated);
}

// ============================ task adopt ============================

// 注册表（.agents/tasks/*.json）是运行时状态，可能被误删；adopt 从任务 worktree
// 内的 .agents/TASK.md + 任务分支重建记录，把孤儿任务重新纳入管理。
function cmdTaskAdopt(argv) {
  parseFlags(argv);
  const cwd = normalizePath(process.cwd());
  const contextFile = taskContextPath(cwd);
  if (!isFile(contextFile)) {
    die(`当前目录没有任务上下文：${contextFile}\ntask adopt 需在孤儿任务的 worktree 内运行（从 .agents/TASK.md 与任务分支重建注册表记录）`);
  }
  const text = fs.readFileSync(contextFile, 'utf8');
  const field = (name) => {
    const m = text.match(new RegExp(`^${name}: (.*)$`, 'm'));
    return m ? m[1].trim() : '';
  };
  const id = field('Task ID');
  const platform = field('Platform');
  const agent = field('Agent');
  const baseBranch = field('Base Branch');
  const taskBranch = field('Task Branch');
  const statusLine = field('Status');
  const created = field('Created');
  validateSlug('task id', id);
  validateSlug('agent 名', agent);
  if (!platform || !baseBranch || !taskBranch) {
    die(`TASK.md 缺少关键字段（Platform / Base Branch / Task Branch）：${contextFile}`);
  }

  const file = taskPath(id);
  if (isFile(file)) die(`任务记录已存在：${file}（无需 adopt）`);
  if (!branchExists(taskBranch)) die(`任务分支不存在：${taskBranch}——没有分支就没有可恢复的提交，拒绝凭空 adopt`);
  if (!branchExists(baseBranch)) {
    warn(`基点分支 ${baseBranch} 不存在（平台可能已改名）：记录照建，integrate 前需先对齐平台 registry。`);
  }

  // ## <标题> 与下一个 ## 之间的内容
  const sectionBody = (title) => {
    const m = text.match(new RegExp(`## ${title}\\n\\n([\\s\\S]*?)\\n## `));
    return m ? m[1] : '';
  };
  const objective = sectionBody('Objective').split('\n')[0].trim() || id;
  const requirements = sectionBody('Requirements')
    .split('\n')
    .filter((l) => l.startsWith('- '))
    .map((l) => l.slice(2).trim())
    .filter(Boolean);
  const scopeBody = sectionBody('Scope');
  const allowed = scopeBody.startsWith('Allowed paths: 未限定')
    ? []
    : scopeBody.split('\n').filter((l) => l.startsWith('- ')).map((l) => l.slice(2).trim()).filter(Boolean);
  const status = STATUSES.includes(statusLine) ? statusLine : 'active';

  const mb = git(['-C', ROOT, 'merge-base', taskBranch, baseBranch]);
  if (mb.status !== 0) {
    die(`无法求 merge-base：${taskBranch} 与 ${baseBranch} 无共同祖先，拒绝 adopt`);
  }
  const baseCommit = mb.stdout.trim();

  if (!buildPlatforms().some((r) => r.id === platform)) {
    warn(`平台 ${platform} 不在当前 registry 中：记录照建，集成前先在 .agents/config/platforms.json 对齐。`);
  }

  const task = normalizeTask({
    id,
    uuid: crypto.randomUUID(),
    schema_version: 1,
    title: objective,
    objective,
    requirements,
    platform,
    agent,
    base_branch: baseBranch,
    base_commit: baseCommit,
    task_branch: taskBranch,
    worktree: cwd,
    worktree_rel: relToRoot(cwd),
    status,
    allowed_paths: allowed,
    feature: null,
    parent_task: null,
    test_command: null,
    test_timeout: null,
    created_at: created || new Date().toISOString(),
    updated_at: new Date().toISOString(),
    finished_at: null,
    finished_commit: null,
    merged_at: null,
    merged_into: null,
    merged_commit: null,
  });

  withRegistryLock(() => {
    if (isFile(file)) die(`任务记录已存在：${file}（无需 adopt）`);
    writeTask(task);
  });
  ensureTaskContextExcluded();

  if (JSON_OUT) {
    note(JSON.stringify({ adopted: task.id, platform, agent, task_branch: taskBranch, base_commit: baseCommit, status: task.status, allowed_paths: allowed }, null, 2));
    return;
  }
  note(`Task adopted: ${task.id}`);
  note(`  Platform:   ${platform}`);
  note(`  Agent:      ${agent}`);
  note(`  Branch:     ${taskBranch}`);
  note(`  Worktree:   ${cwd}`);
  note(`  Base:       ${baseBranch} @ ${baseCommit.slice(0, 8)}`);
  note(`  Status:     ${status}`);
  note('Allowed paths:');
  note(allowedBlock(allowed));
  note('');
  note(`已重建注册表记录：${file}`);
  note('');
  printNext(task);
}

// ============================ task start ============================

function cmdTaskStart(argv) {
  const { flags, positional } = parseFlags(argv, { bool: ['--dry-run'] });
  const id = positional[0];
  if (!id) usageError('task start 需要 task id');
  const task = readTask(id);
  if (!isDir(task.worktree)) die(`任务 worktree 不存在：${task.worktree}`);
  if (!isFile(taskContextPath(task.worktree))) {
    writeTaskContext(task);
    note(`已生成任务上下文：${taskContextPath(task.worktree)}`);
  }
  const runner = buildRunnerCommand(task);
  const prevDryRun = DRY_RUN;
  if (flags.has('--dry-run')) DRY_RUN = true;
  try {
    const rc = startWorker(task, runner);
    if (rc !== 0) process.exit(rc);
  } finally {
    DRY_RUN = prevDryRun;
  }
}

// ============================ merge-check ============================

// 只读：不动平台 worktree、不创建或移动分支
function mergeCheckRun(platformBranch, taskBranch) {
  const r = git(['-C', ROOT, 'merge-tree', '--write-tree', '--name-only', platformBranch, taskBranch]);
  if (r.status === 0) return { clean: true, conflicts: [], mode: 'merge-tree' };
  if (r.status === 1) {
    const ls = r.stdout.split('\n');
    const conflicts = [];
    for (let i = 1; i < ls.length; i++) {
      if (ls[i] === '') break;
      conflicts.push(ls[i]);
    }
    return { clean: false, conflicts, mode: 'merge-tree' };
  }
  return mergeCheckViaWorktree(platformBranch, taskBranch);
}

// 回退路径：临时 integration worktree（旧版 git 无 merge-tree --write-tree）
function mergeCheckViaWorktree(platformBranch, taskBranch) {
  const tmp = path.join(STATE_DIR, 'tmp', `merge-check-${process.pid}`);
  fs.mkdirSync(path.dirname(tmp), { recursive: true });
  if (git(['-C', ROOT, 'worktree', 'add', '--detach', '--quiet', tmp, platformBranch]).status !== 0) {
    die(`无法创建临时 integration worktree：${tmp}`);
  }
  const res = git(['-c', 'rerere.enabled=false', '-C', tmp, 'merge', '--no-commit', '--no-ff', '-m', 'merge-check', taskBranch]);
  const unmerged = lines(git(['-C', tmp, 'diff', '--name-only', '--diff-filter=U']).stdout);
  git(['-C', tmp, 'merge', '--abort']);
  git(['-C', ROOT, 'worktree', 'remove', '--force', tmp]);
  if (unmerged.length > 0) return { clean: false, conflicts: unmerged, mode: 'temp-worktree' };
  return { clean: res.status === 0, conflicts: [], mode: 'temp-worktree' };
}

function cmdTaskMergeCheck(argv) {
  const { positional } = parseFlags(argv);
  const id = positional[0];
  if (!id) usageError('task merge-check 需要 task id');
  const task = readTask(id);
  if (!branchExists(task.task_branch)) die(`任务分支不存在：${task.task_branch}`);
  const row = resolvePlatform(task.platform);

  const platformDirty = worktreeState(row.worktree) === 'dirty';
  const behind = task.base_commit && revParse(task.base_commit) ? revListCount(`${task.base_commit}..refs/heads/${row.branch}`) : 0;
  const tip = git(['-C', ROOT, 'rev-parse', `refs/heads/${task.task_branch}`]).stdout.trim();
  const fastForward = isAncestor(row.branch, tip);

  const result = mergeCheckRun(row.branch, task.task_branch);

  if (JSON_OUT) {
    note(JSON.stringify({
      id: task.id,
      into: row.branch,
      from: task.task_branch,
      clean: result.clean,
      conflicts: result.conflicts,
      platform_worktree: platformDirty ? 'dirty' : 'clean',
      platform_commits_since_base: behind,
      fast_forward: fastForward,
      mode: result.mode,
    }, null, 2));
    process.exit(result.clean ? 0 : 1);
  }

  note(`Merge check: ${task.task_branch} → ${row.branch}`);
  note(`Platform worktree: ${platformDirty ? 'dirty' : 'clean'}（${relToRoot(row.worktree)}）`);
  note(`平台分支自任务基点以来的提交数：${behind}`);
  if (platformDirty) {
    warn('平台 worktree 有未提交改动：integrate 会拒绝执行，请先在其内提交或清理（agentctl 不会动你的工作区）。');
  }
  if (result.clean) {
    note(`Result: CLEAN（可合并；可快进：${fastForward ? 'yes' : 'no'}）`);
    note('');
    note(`Next: ${SELF} task integrate ${task.id}`);
    return;
  }
  note(`Result: CONFLICT（${result.mode} 判定；平台 worktree 未被改动）`);
  note('');
  note('Conflicted files:');
  note(result.conflicts.map((c) => `  ${c}`).join('\n'));
  note('');
  note('物理隔离解决的是覆盖问题；逻辑冲突由 Git 在集成阶段暴露，需人 / agent 解决：');
  note(`  ${SELF} task integrate ${task.id}   # 冲突时保留进行中的 merge，解决后重跑本命令收尾`);
  process.exit(1);
}

// ============================ integrate ============================

function platformCleanOrDie(row) {
  const st = git(['-C', row.worktree, 'status', '--porcelain']).stdout;
  if (st.trim() !== '') {
    die(`平台 worktree 存在未提交改动，拒绝 integrate（agentctl 不会执行 reset / checkout / merge / rebase 等可能破坏你状态的操作）：\n${row.worktree}\n${st.trim()}\n\n请先在该 worktree 内提交或清理，再重试。`);
  }
}

function cmdTaskIntegrate(argv) {
  const { flags, positional } = parseFlags(argv, { bool: ['--force'] });
  const id = positional[0];
  if (!id) usageError('task integrate 需要 task id');
  const force = flags.has('--force');
  const task = readTask(id);
  const row = resolvePlatform(task.platform);

  if (!branchExists(task.task_branch)) die(`任务分支不存在：${task.task_branch}`);
  if (!isDir(row.worktree)) die(`平台 worktree 不存在：${row.worktree}`);

  if (task.status === 'merged') {
    die(`任务 ${task.id} 已并入 ${task.merged_into}（${(task.merged_commit || '').slice(0, 8)}）；如需回收执行 agentctl task remove ${task.id}`);
  }
  if (!['ready', 'conflict', 'integrating'].includes(task.status) && !force) {
    die(`任务状态是 ${task.status}，需先通过 finish（${SELF} task finish ${task.id}）才允许 integrate；如确认跳过检查，使用 --force`);
  }

  const headRef = currentBranch(row.worktree);
  if (headRef !== row.branch) {
    die(`平台 worktree 当前检出分支是 ${headRef}，期望 ${row.branch}（不在预期 worktree 内执行 merge）`);
  }

  const tip = git(['-C', ROOT, 'rev-parse', `refs/heads/${task.task_branch}`]).stdout.trim();
  if (task.finished_commit && tip !== task.finished_commit && !force) {
    die(`任务分支 tip 已变化（finish 时 ${task.finished_commit.slice(0, 8)}，当前 ${tip.slice(0, 8)}）：请重新 finish，或用 --force 合并未经 finish 检查的提交`);
  }
  if (worktreeState(task.worktree) === 'dirty') {
    warn('任务 worktree 存在未提交改动：本次只合并任务分支，这些改动不会被合并。');
  }

  if (mergeInProgress(row.worktree)) {
    // 进行中的 merge：仅当是本任务冲突的续做才放行
    const mergeHead = git(['-C', row.worktree, 'rev-parse', 'MERGE_HEAD']).stdout.trim();
    if (mergeHead !== tip) {
      die(`平台 worktree 存在其他进行中的 merge（MERGE_HEAD=${mergeHead.slice(0, 8)}，本任务 ${tip.slice(0, 8)}）：请先收尾或放弃（cd ${row.worktree} && git merge --abort）`);
    }
    const unmerged = lines(git(['-C', row.worktree, 'diff', '--name-only', '--diff-filter=U']).stdout);
    if (unmerged.length > 0) {
      updateTask(task.id, { status: 'conflict' });
      note(`Merge 仍在进行中（${task.task_branch} → ${row.branch}），以下文件冲突尚未解决：`);
      note(unmerged.map((f) => `  ${f}`).join('\n'));
      note('');
      note(`解决后：cd ${row.worktree} && git add <files>，再执行 ${SELF} task integrate ${task.id} 收尾。`);
      process.exit(1);
    }
    note('冲突已解决，收尾合并提交…');
    updateTask(task.id, { status: 'integrating' });
    const commit = git(['-C', row.worktree, 'commit', '--no-edit']);
    if (commit.status !== 0) {
      updateTask(task.id, { status: 'failed' });
      die(`收尾合并提交失败（cd ${row.worktree} && git status 查看）`);
    }
  } else {
    platformCleanOrDie(row);
    note(`Integrating: ${task.task_branch} → ${row.branch}（${relToRoot(row.worktree)}）`);
    updateTask(task.id, { status: 'integrating' });
    const res = git(['-C', row.worktree, 'merge', '--no-ff', '-m', `merge(agent): 合并 ${task.task_branch} 至 ${row.branch}`, task.task_branch]);
    if (res.status !== 0) {
      if (mergeInProgress(row.worktree)) {
        updateTask(task.id, { status: 'conflict' });
        const conflicted = lines(git(['-C', row.worktree, 'diff', '--name-only', '--diff-filter=U']).stdout);
        note('');
        note('Merge CONFLICT：平台 worktree 中保留了进行中的 merge（未回退、未丢弃任何内容）。');
        note('');
        note('Conflicted files:');
        note(conflicted.map((f) => `  ${f}`).join('\n'));
        note('');
        note(`解决后：cd ${row.worktree} && git add <files>，再执行 ${SELF} task integrate ${task.id} 收尾提交并标记 merged。`);
        note(`放弃本次合并：cd ${row.worktree} && git merge --abort（然后 ${SELF} task set-status ${task.id} ready）`);
        process.exit(1);
      }
      updateTask(task.id, { status: 'failed' });
      die(`merge 失败（cd ${row.worktree} && git status 查看）\n${(res.stderr || res.stdout).trim()}`);
    }
  }

  const head = git(['-C', row.worktree, 'rev-parse', 'HEAD']).stdout.trim();
  updateTask(task.id, {
    status: 'merged',
    merged_at: new Date().toISOString(),
    merged_into: row.branch,
    merged_commit: head,
  });

  note('');
  note(`Task ${task.id} 已并入 ${row.branch}（${head.slice(0, 8)}）。`);
  note(`平台 worktree：${row.worktree} —— 后续由平台级测试 / 评审流程处理。`);
  note('');
  note('Next:');
  note(`  cd ${row.worktree}   # 平台级 test / review / release`);
  note(`  ${SELF} task remove ${task.id}   # 确认并入且工作区干净后回收`);
}

// ============================ task remove ============================

function cmdTaskRemove(argv) {
  const { flags, positional } = parseFlags(argv, { bool: ['--force'] });
  const id = positional[0];
  if (!id) usageError('task remove 需要 task id');
  const force = flags.has('--force');
  const task = readTask(id);

  // 注册表状态可能落后于现实（有人在 agentctl 之外手工合并）：分支确已并入平台分支时放行回收
  const pb = platformBranchLookup(task.platform);
  const mergedLive = Boolean(pb) && branchExists(task.task_branch) && branchExists(pb) && isAncestor(task.task_branch, pb);
  if (task.status !== 'merged' && mergedLive) {
    note(`任务状态 ${task.status}，但分支已并入 ${pb}（注册表外的手工合并）：放行回收。`);
  }
  if (task.status !== 'merged' && !mergedLive && !force) {
    die(`任务未并入平台分支（status: ${task.status}），拒绝删除。如确认丢弃该任务与其分支，使用：agentctl task remove ${task.id} --force`);
  }
  if (task.status !== 'merged' && !mergedLive) {
    warn(`任务状态为 ${task.status}（未并入平台分支）：--force 将删除其 worktree 与分支，未合并的提交只会留在 reflog 中。`);
  }

  const wtState = worktreeState(task.worktree);
  if (wtState === 'dirty') {
    const st = git(['-C', task.worktree, 'status', '--porcelain']).stdout.trim();
    if (!force) {
      die(`任务 worktree 存在未提交改动（含未跟踪文件），拒绝删除——agentctl 不会丢弃你的修改：\n${task.worktree}\n${st}\n\n如确认丢弃，使用：agentctl task remove ${task.id} --force`);
    }
    warn('按 --force 丢弃以下未提交改动：');
    process.stderr.write(`${st}\n`);
  }

  if (wtState === 'missing') {
    note(`任务 worktree 已不存在：${task.worktree}（跳过 worktree 回收）`);
  } else {
    const rm = git(['-C', ROOT, 'worktree', 'remove', ...(force ? ['--force'] : []), task.worktree]);
    if (rm.status !== 0) die(`worktree 回收失败：${task.worktree}\n${(rm.stderr || '').trim()}${force ? '' : '（可用 --force）'}`);
    note(`已回收 worktree：${task.worktree}`);
  }

  if (branchExists(task.task_branch)) {
    if (!mergedLive && !force) {
      die(`分支 ${task.task_branch} 未确认并入 ${pb || '平台分支'}，拒绝删除（如确认丢弃，用 --force）`);
    }
    if (!mergedLive) warn(`分支 ${task.task_branch} 未确认并入 ${pb || '平台分支'}，按 --force 强删`);
    const del = git(['-C', ROOT, 'branch', '-D', task.task_branch]);
    if (del.status !== 0) die(`分支删除失败：${task.task_branch}\n${(del.stderr || '').trim()}`);
    note(`已删除分支：${task.task_branch}`);
  }

  fs.rmSync(task.file, { force: true });
  note(`已删除任务记录：${task.file}`);
}

// ============================ doctor ============================

function cmdDoctor(argv) {
  parseFlags(argv);
  const checks = [];
  const add = (name, ok, detail) => checks.push({ name, ok, detail });

  const gitVer = git(['--version']).stdout.trim();
  add('Git', git(['--version']).status === 0, gitVer);
  const nodeMajor = Number.parseInt(process.version.slice(1), 10);
  add('Node', nodeMajor >= 20, `${process.version}${nodeMajor >= 20 ? '' : '（agentctl 需要 node ≥ 20）'}`);
  add('Repository', true, `${ROOT}（${currentBranch(ROOT)}）`);

  const wtSupport = git(['worktree', 'list', '--porcelain']).status === 0;
  add('Worktree support', wtSupport, wtSupport ? 'git worktree 可用' : 'git worktree 不可用');

  const platforms = buildPlatforms();
  add('Platform Worktrees', platforms.length > 0 && platforms.every((r) => r.state === 'ok'),
    platforms.length ? `${platforms.filter((r) => r.state === 'ok').length}/${platforms.length} 可用` : '未识别到平台 worktree');

  const tasks = listTasks().map((id) => readTask(id));
  const byStatus = {};
  for (const t of tasks) byStatus[t.status] = (byStatus[t.status] || 0) + 1;
  add('Task Registry', isDir(TASKS_DIR) || tasks.length === 0,
    `${tasks.length} 条任务${tasks.length ? `（${Object.entries(byStatus).map(([k, v]) => `${k}:${v}`).join(' ')}）` : ''}`);

  const giPath = path.join(ROOT, '.gitignore');
  const giLines = isFile(giPath) ? new Set(fs.readFileSync(giPath, 'utf8').split('\n').map((l) => l.trim())) : new Set();
  const giMissing = ['.agents/tasks/', '.agents/state/'].filter((e) => !giLines.has(e) && !giLines.has(`/${e}`));
  add('Runtime state gitignore', giMissing.length === 0 || tasks.length === 0,
    giMissing.length === 0
      ? '.gitignore 已排除 .agents/tasks/ 与 .agents/state/'
      : tasks.length === 0
        ? `尚无任务；需要时用 agentctl init 或在 .gitignore 追加：${giMissing.map((e) => `/${e}`).join(' ')}`
        : `.gitignore 缺少 ${giMissing.map((e) => `/${e}`).join(' ')}：任务记录会污染 git status（agentctl init 可自动补）`);

  add('Worktree root', !WORKTREE_ROOT_INSIDE,
    WORKTREE_ROOT_INSIDE
      ? `${WORKTREE_ROOT} 位于主 checkout 内部，任务 worktree 会污染主 checkout 的 git status；建议在 .agents/config/platforms.json 把 worktree_root 配置为仓库外的同级目录`
      : WORKTREE_ROOT);

  // agent/<agent>/<task-id> 分支存在但没有注册表记录 → 注册表被误删的孤儿
  const orphanBranches = git(['-C', ROOT, 'branch', '--format=%(refname:short)'])
    .stdout.split('\n')
    .map((s) => s.trim())
    .filter((b) => b.startsWith(`${BRANCH_PREFIX}/`))
    .map((b) => ({ branch: b, id: b.slice(BRANCH_PREFIX.length + 1).split('/').pop() }))
    .filter((e) => e.id && !isFile(taskPath(e.id)))
    .map((e) => e.branch);
  add('Orphan task branches', orphanBranches.length === 0,
    orphanBranches.length
      ? `${orphanBranches.length} 条未登记：${orphanBranches.join('　')}（在对应 worktree 内运行 agentctl task adopt 可恢复）`
      : '无未登记的 agent 分支');

  const agentRows = [...new Set([...Object.keys(BUILTIN_RUNNERS), ...Object.keys(AGENT_CONFIG)])].map((n) => runnerFor(n));
  const detectedAgents = agentRows.filter((r) => r.detected).map((r) => r.name);
  add('Agent executables', detectedAgents.length > 0,
    agentRows.map((r) => `${r.name}: ${r.detected ? 'detected' : 'not found'}`).join('　'));

  const agentsMd = isFile(path.join(ROOT, 'AGENTS.md'));
  add('AGENTS.md', agentsMd, agentsMd ? path.join(ROOT, 'AGENTS.md') : '缺少 AGENTS.md');

  const cwdTask = taskForWorktree(process.cwd());
  const contextFile = taskContextPath(normalizePath(process.cwd()));
  const mode = cwdTask && isFile(contextFile) ? `worker（${cwdTask.id}）` : 'coordinator';
  add('Mode', true, `${mode}　cwd=${normalizePath(process.cwd())}`);

  const excludeFile = path.join(gitCommonDir(), 'info', 'exclude');
  const excluded = isFile(excludeFile) && fs.readFileSync(excludeFile, 'utf8').split('\n').some((l) => l.trim() === '.agents/TASK.md');
  add('Task context exclude', excluded || tasks.length === 0,
    excluded ? `.agents/TASK.md 已在 ${excludeFile} 中排除` : '尚无任务（首次 task create 时自动写入 info/exclude）');

  if (JSON_OUT) {
    note(JSON.stringify({ root: ROOT, worktree_root: WORKTREE_ROOT, checks, platforms: platformRowsForOutput(), agents: agentRows.map((r) => ({ agent: r.name, detected: r.detected, path: r.path, provider: r.provider })) }, null, 2));
    return;
  }

  note('Agent Task System');
  note('');
  for (const c of checks) {
    note(`${c.name}: ${c.ok ? 'OK' : 'FAIL'}${c.detail ? `　${c.detail}` : ''}`);
  }
  note('');
  note('Platform Worktrees:');
  for (const r of platforms) {
    note(`  ${r.id}: ${r.state === 'ok' ? 'OK' : `FAIL（${r.state}）`}　${relToRoot(r.worktree)} @ ${r.branch}　[${worktreeState(r.worktree)}]`);
  }
  note('');
  note('Agents:');
  for (const r of agentRows) {
    note(`  ${r.name}: ${r.detected ? 'detected' : 'not found'}${r.detected ? `（${r.path}）` : ''}　[${r.provider}]`);
  }
  note('');
  note('Task Worktrees:');
  if (tasks.length === 0) {
    note('  （无任务）');
  } else {
    for (const t of tasks) {
      note(`  ${t.id}: ${t.status}　${t.platform}　${t.agent}　${worktreeState(t.worktree)}`);
    }
  }
  note('');
  note(`任务 worktree 根：${WORKTREE_ROOT}`);
}

// ============================ help ============================

function cmdHelp() {
  note(`agentctl ${VERSION} — Agent 任务级 worktree 管理（两级 worktree 模型的第二级）

用法：
  agentctl [-C <目录>] [--json] <命令> [参数]

自检：
  agentctl init                      项目内初始化：探测平台生成 platforms.json、补 .gitignore 排除（幂等不覆盖）
  agentctl doctor                    Git / 仓库 / 平台 worktree / 任务 registry / Agent CLI / AGENTS.md
  agentctl agent list                列出内置 Agent runner 与检测结果
  agentctl platform list             列出平台 registry（探测 + .agents/config/platforms.json 声明）
  agentctl task current              判断当前目录处于 Coordinator 还是 Worker 模式

任务：
  agentctl task create --platform <平台> --agent <agent> [--title <文本>] [--task <id>] [选项]
      创建任务分支 agent/<agent>/<task-id> 与独立任务 worktree
      <worktree_root>/<platform>/<task-id>，写入 .agents/tasks/<id>.json 与任务上下文 .agents/TASK.md。
      task id 缺省时按标题自动生成（<平台>-<slug>-NNN，同名递增）。
      选项：
        --title <文本>             任务标题（自动 task id 的来源）
        --objective <文本>         Objective（默认同 title）
        --requirements <列表>      要求列表，分号或换行分隔
        --allowed-paths <glob,..>  允许改动的路径（相对任务 worktree 根；空 = 不检查范围）
        --feature <名称>           跨平台 feature 分组标记
        --parent <名称>            feature 内父级任务标记
        --test-command '<cmd>'     finish 时执行的测试命令（默认取平台配置）
        --timeout <秒>             finish 测试超时秒数（默认取平台 test_timeout）
        --allow-overlap            与已有任务 scope 重叠时仍创建（显式确认）
        --dry-run                  只打印将创建的内容
        --start                    创建后立即启动 Worker（不可用时降级为打印命令）
  agentctl task list [--platform <p>] [--agent <a>] [--status <s>] [--feature <f>]
  agentctl task show <id>
  agentctl task start <id> [--dry-run]      按 AgentRunner 启动 Worker
  agentctl task check <id>                  校验实际改动是否越出 allowed_paths（越界退出码 1）
  agentctl task diff <id> [--stat|--name-only] [--working]
  agentctl task finish <id> [--no-test] [--test-command '<cmd>'] [--timeout <秒>]
      门禁：worktree 与分支正确、无未提交改动、改动未越界、至少一个 commit、测试通过。
      通过后状态置 ready 并输出 Worker 完成摘要；不删除、不丢弃任何改动。
  agentctl task set-status <id> <status>    标记 blocked / failed / cancelled 等
      状态：${STATUSES.join(' / ')}
  agentctl task update-base <id> [--dry-run]  把平台分支新提交合并进任务分支并刷新基点
      冲突时保留进行中的 merge，解决后重跑收尾；ready 任务基点变更后状态退回 active。
  agentctl task adopt                       在孤儿任务 worktree 内从 .agents/TASK.md 重建注册表记录
  agentctl task merge-check <id>            只读判断能否并入平台分支（不改动平台 worktree）
  agentctl task integrate <id> [--force]    在平台 worktree 内 --no-ff 合并任务分支
  agentctl task remove <id> [--force]       仅 merged + 干净时回收 worktree / 分支 / 记录

约定：
  · 平台 worktree 是 integration 边界；agent 开发一律在任务 worktree 内。
  · .agents/tasks/*.json 为运行时状态（不入库）；注册表读改写走锁 + 原子替换。
  · 不做文件锁：覆盖由 worktree 隔离，逻辑冲突交 Git 合并。
  · 在仓库主 checkout 或其任意 worktree 内均可运行（-C 指定目录）。`);
}

// ============================ 入口 ============================

let DRY_RUN = false;

function main() {
  const argv = process.argv.slice(2);
  const rest = [];
  let cmd = null;

  for (let i = 0; i < argv.length; i++) {
    const a = argv[i];
    if (cmd === null && (a === '-C' || a === '--directory')) {
      if (i + 1 >= argv.length) usageError('-C 需要目录参数');
      try {
        process.chdir(argv[++i]);
      } catch (e) {
        die(`无法进入目录：${argv[i]}（${e.message}）`);
      }
    } else if (a === '--json') {
      JSON_OUT = true;
    } else if (cmd === null && (a === '--version' || a === '-V')) {
      note(`agentctl ${VERSION}`);
      return;
    } else if (cmd === null && (a === '--help' || a === '-h')) {
      cmdHelp();
      return;
    } else if (cmd === null && !a.startsWith('-')) {
      cmd = a;
    } else {
      rest.push(a);
    }
  }

  if (!cmd || cmd === 'help') {
    cmdHelp();
    return;
  }
  if (cmd === 'version') {
    note(`agentctl ${VERSION}`);
    return;
  }

  ROOT = resolveRoot();
  configInit();

  if (cmd === 'init') return cmdInit(rest);
  if (cmd === 'doctor') return cmdDoctor(rest);
  if (cmd === 'platform') {
    const sub = rest[0] || 'list';
    if (sub !== 'list') usageError(`未知子命令：platform ${sub}`);
    return cmdPlatformList();
  }
  if (cmd === 'agent') {
    const sub = rest[0] || 'list';
    if (sub !== 'list') usageError(`未知子命令：agent ${sub}`);
    return cmdAgentList(rest.slice(1));
  }
  if (cmd === 'task') {
    const sub = rest[0];
    const args = rest.slice(1);
    switch (sub) {
      case 'create': return cmdTaskCreate(args);
      case 'list': return cmdTaskList(args);
      case 'show': return cmdTaskShow(args);
      case 'current': return cmdTaskCurrent(args);
      case 'check': return cmdTaskCheck(args);
      case 'diff': return cmdTaskDiff(args);
      case 'finish': return cmdTaskFinish(args);
      case 'set-status': return cmdTaskSetStatus(args);
      case 'update-base': return cmdTaskUpdateBase(args);
      case 'adopt': return cmdTaskAdopt(args);
      case 'start': return cmdTaskStart(args);
      case 'merge-check': return cmdTaskMergeCheck(args);
      case 'integrate': return cmdTaskIntegrate(args);
      case 'remove': return cmdTaskRemove(args);
      case undefined:
      case 'help': return cmdHelp();
      default: usageError(`未知子命令：task ${sub}`);
    }
  }
  usageError(`未知命令：${cmd}`);
}

main();
