#!/usr/bin/env node
'use strict';
//
// agentctl — 两级 worktree 模型的第二级：Agent 任务级 worktree 管理
//
// 模型：
//   平台 worktree（Platform Worktree，长期存在，如 wt/php-backend @ feature/php-backend）
//       —— 平台级 integration 边界：只做 merge / test / debug / review / release，
//          不作为 Coding Agent 的日常开发目录。
//   Agent 任务 worktree（Task Worktree，一条任务一个）
//       ../<repo>-agent-worktrees/<platform>/<task-id> @ agent/<agent>/<task-id>
//       —— 单个 Agent 的独立开发工作区，物理文件隔离由 git worktree 提供，
//          内含 .agents/TASK.md 作为当前任务上下文（由 .git/info/exclude 排除，不进业务提交）。
//
// 状态：
//   .agents/config/platforms.json   平台 registry（入库；缺省时按 git worktree 自动探测）
//   .agents/config/agents.json      Agent runner 命令模板（可选，用于未内置实测参数的 CLI）
//   .agents/tasks/<task-id>.json    任务元数据（运行时状态，不入库）
//   .agents/state/                  运行时临时产物与注册表锁（不入库）
//
// 依赖：node ≥ 20、git。无第三方依赖。手册：README.md

const fs = require('node:fs');
const path = require('node:path');
const crypto = require('node:crypto');
const { spawnSync, spawn } = require('node:child_process');

const VERSION = '0.0.2';

// 输出被下游提前关闭（如 `agentctl ... | head`）时静默退出，不抛 EPIPE 堆栈
process.stdout.on('error', (err) => {
  if (err && err.code === 'EPIPE') process.exit(0);
  throw err;
});
process.stderr.on('error', () => {});

const SELF = (() => {
  try {
    return fs.realpathSync(process.argv[1]);
  } catch {
    return process.argv[1];
  }
})();

// ============================ 基础输出 ============================

function note(msg = '') {
  process.stdout.write(`${msg}\n`);
}

function warn(msg) {
  process.stderr.write(`WARNING: ${msg}\n`);
}

function die(msg) {
  process.stderr.write(`ERROR: ${msg}\n`);
  process.exit(2);
}

function usageError(msg) {
  process.stderr.write(`ERROR: ${msg}\n`);
  process.stderr.write('运行 agentctl help 查看用法。\n');
  process.exit(2);
}

function okFail(ok) {
  return ok ? 'OK' : 'FAIL';
}

function sleepMs(ms) {
  Atomics.wait(new Int32Array(new SharedArrayBuffer(4)), 0, 0, ms);
}

// ============================ git ============================

const GIT_ENV = { ...process.env, LC_ALL: 'C' };

function git(args, opts = {}) {
  const res = spawnSync('git', args, {
    cwd: opts.cwd,
    env: GIT_ENV,
    encoding: 'utf8',
    maxBuffer: 256 * 1024 * 1024,
  });
  if (res.error) die(`无法执行 git：${res.error.message}`);
  return { status: res.status === null ? 1 : res.status, stdout: res.stdout ?? '', stderr: res.stderr ?? '' };
}

function gitOut(args, opts = {}) {
  const r = git(args, opts);
  if (r.status !== 0) die(`git ${args.join(' ')} 失败：${(r.stderr || r.stdout).trim()}`);
  return r.stdout;
}

function gitQuiet(args, opts = {}) {
  return git(args, opts).status === 0;
}

function lines(text) {
  return text.split('\n').filter((l) => l !== '');
}

function isDir(p) {
  try {
    return fs.statSync(p).isDirectory();
  } catch {
    return false;
  }
}

function isFile(p) {
  try {
    return fs.statSync(p).isFile();
  } catch {
    return false;
  }
}

// ============================ 仓库与配置 ============================

let ROOT = '';
let AGENT_DIR = '';
let CONFIG_FILE = '';
let TASKS_DIR = '';
let STATE_DIR = '';
let WORKTREE_ROOT = '';
let BRANCH_PREFIX = 'agent';
let CONFIG = {}; // .agents/config/platforms.json
let AGENT_CONFIG = {}; // .agents/config/agents.json
let PLATFORMS_CACHE = null; // 单次调用内缓存平台表（一条命令内不会增删平台 worktree）
let WORKTREE_ROOT_INSIDE = false; // worktree_root 落在仓库主 checkout 内部时为 true（告警用）

function resolveRoot() {
  const common = git(['rev-parse', '--path-format=absolute', '--git-common-dir']);
  if (common.status !== 0) {
    die('当前目录不在 git 仓库内：agentctl 需在仓库主 checkout 或其任一 worktree 内运行');
  }
  const commonDir = common.stdout.trim();
  if (git(['rev-parse', '--is-bare-repository']).stdout.trim() === 'true') {
    die('裸仓库没有工作区，不支持 agentctl');
  }
  if (path.basename(commonDir) === '.git') return path.dirname(commonDir);
  return gitOut(['rev-parse', '--path-format=absolute', '--show-toplevel']).trim();
}

// 绝对化；存在时解析符号链接（与 git 报告的 worktree 路径可比对）
function normalizePath(p) {
  const abs = path.isAbsolute(p) ? p : path.join(ROOT, p);
  try {
    return fs.realpathSync(abs);
  } catch {
    return path.resolve(abs).replace(/(.)\/+$/, '$1');
  }
}

function readJsonConfig(file, label) {
  if (!isFile(file)) return {};
  let parsed;
  try {
    parsed = JSON.parse(fs.readFileSync(file, 'utf8'));
  } catch (e) {
    die(`${label} 不是合法 JSON：${file}（${e.message}）`);
  }
  if (parsed === null || typeof parsed !== 'object' || Array.isArray(parsed)) {
    die(`${label} 顶层必须是对象：${file}`);
  }
  return parsed;
}

function configInit() {
  AGENT_DIR = path.join(ROOT, '.agents');
  CONFIG_FILE = path.join(AGENT_DIR, 'config', 'platforms.json');
  TASKS_DIR = path.join(AGENT_DIR, 'tasks');
  STATE_DIR = path.join(AGENT_DIR, 'state');

  CONFIG = readJsonConfig(CONFIG_FILE, '平台配置');
  AGENT_CONFIG = readJsonConfig(path.join(AGENT_DIR, 'config', 'agents.json'), 'Agent 配置');

  const wr =
    typeof CONFIG.worktree_root === 'string' && CONFIG.worktree_root
      ? CONFIG.worktree_root
      : path.join('..', `${path.basename(ROOT)}-agent-worktrees`);
  BRANCH_PREFIX = typeof CONFIG.branch_prefix === 'string' && CONFIG.branch_prefix ? CONFIG.branch_prefix : 'agent';
  WORKTREE_ROOT = normalizePath(wr);
  WORKTREE_ROOT_INSIDE = isUnder(WORKTREE_ROOT, ROOT);
}

// ============================ 平台注册表 ============================
// 平台 = 长期存在的平台 worktree（主 checkout 与任务 worktree 除外）。
// 来源：git worktree 自动探测 + .agents/config/platforms.json 声明（声明提供 id 与别名；
// 路径、分支以实际 worktree 为准，不一致即报错，不静默改写）。

function detectPlatforms() {
  const raw = gitOut(['-C', ROOT, 'worktree', 'list', '--porcelain']);
  const all = [];
  let cur = null;
  for (const line of raw.split('\n')) {
    if (line.startsWith('worktree ')) {
      cur = { path: line.slice('worktree '.length), branch: null, skip: false };
      all.push(cur);
    } else if (line.startsWith('branch refs/heads/')) {
      if (cur) cur.branch = line.slice('branch refs/heads/'.length);
    } else if (line === 'detached' || line === 'bare') {
      if (cur) cur.skip = true;
    }
  }
  const detected = [];
  for (const wt of all) {
    if (wt.skip || !wt.branch) continue;
    const abs = normalizePath(wt.path);
    if (abs === ROOT) continue; // 主 checkout = 文档/契约枢纽
    if (isUnder(abs, WORKTREE_ROOT)) continue; // 任务 worktree
    detected.push({ path: abs, branch: wt.branch });
  }
  return detected;
}

function isUnder(p, dir) {
  return p === dir || p.startsWith(`${dir}${path.sep}`);
}

function buildPlatforms() {
  if (!PLATFORMS_CACHE) PLATFORMS_CACHE = buildPlatformsUncached();
  return PLATFORMS_CACHE;
}

function buildPlatformsUncached() {
  const detected = detectPlatforms();
  const rows = [];
  const used = new Set();
  const declared = CONFIG.platforms && typeof CONFIG.platforms === 'object' ? CONFIG.platforms : {};

  for (const id of Object.keys(declared).sort()) {
    const entry = declared[id] && typeof declared[id] === 'object' ? declared[id] : {};
    const aliases = Array.isArray(entry.aliases) ? entry.aliases.filter((a) => typeof a === 'string') : [];
    const declaredWt = typeof entry.worktree === 'string' ? entry.worktree : '';
    const declaredBr = typeof entry.branch === 'string' ? entry.branch : '';
    if (!declaredWt || !declaredBr) {
      rows.push({ id, worktree: '', branch: '', source: 'declared', state: '配置缺 worktree/branch', aliases });
      continue;
    }
    const abs = normalizePath(declaredWt);
    const idx = detected.findIndex((d) => d.path === abs);
    if (idx === -1) {
      const exists = fs.existsSync(abs);
      rows.push({
        id,
        worktree: abs,
        branch: declaredBr,
        source: 'declared',
        state: exists ? '目录存在但未注册为 worktree' : 'worktree 缺失',
        aliases,
      });
    } else {
      used.add(idx);
      const d = detected[idx];
      rows.push({
        id,
        worktree: d.path,
        branch: d.branch,
        source: 'declared',
        state: d.branch === declaredBr ? 'ok' : `声明分支不符（实际 ${d.branch}）`,
        aliases,
      });
    }
  }

  for (let i = 0; i < detected.length; i++) {
    if (used.has(i)) continue;
    const base = path.basename(detected[i].path);
    let id = base;
    let n = 2;
    while (rows.some((r) => r.id === id)) id = `${base}-${n++}`;
    rows.push({ id, worktree: detected[i].path, branch: detected[i].branch, source: 'detected', state: 'ok', aliases: [] });
  }
  return rows;
}

// 某平台可用的全部名称（id + 声明别名 + 由 id/分支派生的别名）
function aliasesFor(row) {
  const out = [row.id, ...row.aliases];
  if (row.branch) {
    out.push(row.branch);
    const tail = row.branch.split('/').slice(1).join('/');
    if (tail) out.push(tail);
  }
  const dash = row.id.indexOf('-');
  if (dash !== -1) out.push(row.id.slice(dash + 1));
  return [...new Set(out.filter(Boolean))];
}

function resolvePlatform(name) {
  if (!name) die('缺少 --platform');
  const rows = buildPlatforms();
  let row = rows.find((r) => r.id === name);
  if (!row) {
    const matches = rows.filter((r) => aliasesFor(r).includes(name));
    if (matches.length === 0) {
      die(`未知平台：${name}（已注册平台：${rows.map((r) => r.id).join(' ')}）`);
    }
    if (matches.length > 1) {
      die(`平台名有歧义：${name} 同时匹配 ${matches.map((r) => r.id).join(' ')}，请用平台 id 指定`);
    }
    row = matches[0];
  }
  if (row.state !== 'ok') {
    die(`平台 ${row.id} 不可用：${row.state}（worktree=${row.worktree} branch=${row.branch}；请先对齐 .agents/config/platforms.json 与实际 worktree）`);
  }
  if (!branchExists(row.branch)) die(`平台分支不存在：${row.branch}`);
  if (!isDir(row.worktree)) die(`平台 worktree 目录不存在：${row.worktree}`);
  return row;
}

function platformBranchLookup(id) {
  if (!id) return '';
  const rows = buildPlatforms();
  const byId = rows.find((r) => r.id === id);
  if (byId) return byId.state === 'ok' ? byId.branch : '';
  // 任务可能以别名引用平台（如 --platform backend → 声明 id api）
  const byAlias = rows.filter((r) => r.state === 'ok' && aliasesFor(r).includes(id));
  return byAlias.length === 1 ? byAlias[0].branch : '';
}

// ============================ git 细粒度查询 ============================

function worktreeState(wt) {
  if (!wt || !isDir(wt)) return 'missing';
  const r = git(['-C', wt, 'status', '--porcelain']);
  if (r.status !== 0) return 'missing';
  return r.stdout.trim() === '' ? 'clean' : 'dirty';
}

function branchExists(branch) {
  return gitQuiet(['-C', ROOT, 'show-ref', '--verify', '--quiet', `refs/heads/${branch}`]);
}

function isAncestor(a, b) {
  return gitQuiet(['-C', ROOT, 'merge-base', '--is-ancestor', a, b]);
}

function revParse(rev) {
  const r = git(['-C', ROOT, 'rev-parse', '--verify', '--quiet', `${rev}^{commit}`]);
  return r.status === 0 ? r.stdout.trim() : '';
}

function revListCount(range) {
  const r = git(['-C', ROOT, 'rev-list', '--count', range]);
  return r.status === 0 ? Number.parseInt(r.stdout.trim(), 10) || 0 : 0;
}

function mergeInProgress(wt) {
  const r = git(['-C', wt, 'rev-parse', '--path-format=absolute', '--git-path', 'MERGE_HEAD']);
  if (r.status !== 0) return false;
  return isFile(r.stdout.trim());
}

function relToRoot(p) {
  if (!p) return '';
  const prefix = `${ROOT}${path.sep}`;
  return p.startsWith(prefix) ? p.slice(prefix.length) : p;
}

function currentBranch(cwd = process.cwd()) {
  return git(['-C', cwd, 'rev-parse', '--abbrev-ref', 'HEAD']).stdout.trim();
}

function gitCommonDir() {
  return gitOut(['rev-parse', '--path-format=absolute', '--git-common-dir']).trim();
}

// ============================ 并发安全 ============================
// registry 的「读—改—写」走互斥锁 + 原子替换（tmp + rename），
// 避免多 agent 同时 create / finish 时互相覆盖（不做文件级锁，worktree 已保证物理隔离）。

function registryLockPath() {
  return path.join(STATE_DIR, 'locks', 'registry.lock');
}

function withRegistryLock(fn, opts = {}) {
  const timeoutMs = opts.timeoutMs ?? 15000;
  const staleMs = opts.staleMs ?? 120000;
  const lockPath = registryLockPath();
  fs.mkdirSync(path.dirname(lockPath), { recursive: true });
  const started = Date.now();
  for (;;) {
    try {
      fs.mkdirSync(lockPath); // mkdir 是原子操作
      fs.writeFileSync(path.join(lockPath, 'owner'), `pid=${process.pid}\nat=${new Date().toISOString()}\n`);
      break;
    } catch (e) {
      if (e.code !== 'EEXIST') throw e;
      let stale = false;
      try {
        stale = Date.now() - fs.statSync(lockPath).mtimeMs > staleMs;
      } catch {
        stale = true;
      }
      if (stale) {
        try {
          fs.rmSync(lockPath, { recursive: true, force: true });
        } catch {
          /* 抢占失败则下一轮重试 */
        }
        continue;
      }
      if (Date.now() - started > timeoutMs) {
        die(`任务注册表被其他进程锁定：${lockPath}\n等待 ${Math.round(timeoutMs / 1000)}s 未释放；确认无残留进程后删除该目录重试`);
      }
      sleepMs(50);
    }
  }
  try {
    return fn();
  } finally {
    try {
      fs.rmSync(lockPath, { recursive: true, force: true });
    } catch {
      /* 锁释放失败不影响主流程 */
    }
  }
}

function writeJsonAtomic(file, obj) {
  const tmp = `${file}.tmp.${process.pid}`;
  fs.mkdirSync(path.dirname(file), { recursive: true });
  fs.writeFileSync(tmp, `${JSON.stringify(obj, null, 2)}\n`);
  fs.renameSync(tmp, file);
}

// ============================ 任务状态机 ============================

const STATUSES = ['created', 'active', 'ready', 'blocked', 'conflict', 'integrating', 'merged', 'failed', 'cancelled'];
// 未结束状态：参与 scope 重叠判定
const OPEN_STATUSES = new Set(['created', 'active', 'ready', 'blocked', 'conflict', 'integrating']);

// ============================ 任务注册表 ============================

const SLUG_RE = /^[A-Za-z0-9][A-Za-z0-9._-]*$/;

function validateSlug(kind, v) {
  if (!v) die(`${kind} 不能为空`);
  if (v.includes('/') || v.includes('..')) die(`非法 ${kind}：${v}`);
  if (!SLUG_RE.test(v)) die(`非法 ${kind}：${v}（仅允许字母/数字/._-，且以字母或数字开头）`);
}

function taskPath(id) {
  return path.join(TASKS_DIR, `${id}.json`);
}

function normalizeTask(task) {
  const t = { ...task };
  t.allowed_paths = Array.isArray(t.allowed_paths) ? t.allowed_paths : [];
  t.requirements = Array.isArray(t.requirements) ? t.requirements : [];
  t.status = t.status || 'active';
  t.schema_version = Number.isInteger(t.schema_version) ? t.schema_version : 1;
  return t;
}

function readTask(id) {
  validateSlug('task id', id);
  const file = taskPath(id);
  if (!isFile(file)) die(`任务不存在：${id}（未见 ${file}）`);
  let task;
  try {
    task = JSON.parse(fs.readFileSync(file, 'utf8'));
  } catch (e) {
    die(`任务元数据不是合法 JSON：${file}（${e.message}）`);
  }
  for (const k of ['id', 'task_branch', 'worktree']) {
    if (!task[k]) die(`任务元数据缺字段 ${k}：${file}`);
  }
  const t = normalizeTask(task);
  t.file = file;
  return t;
}

function writeTask(task) {
  const file = task.file || taskPath(task.id);
  const out = { ...task };
  delete out.file;
  out.updated_at = new Date().toISOString();
  writeJsonAtomic(file, out);
}

function updateTask(id, patch) {
  return withRegistryLock(() => {
    const task = readTask(id);
    const next = { ...task, ...patch };
    writeTask(next);
    return next;
  });
}

function listTasks() {
  if (!isDir(TASKS_DIR)) return [];
  return fs
    .readdirSync(TASKS_DIR)
    .filter((f) => f.endsWith('.json') && !f.includes('.tmp.'))
    .map((f) => f.slice(0, -'.json'.length))
    .sort();
}

function effectiveTestCommand(task) {
  if (task && typeof task.test_command === 'string' && task.test_command) return task.test_command;
  const entry = CONFIG.platforms && task ? CONFIG.platforms[task.platform] : null;
  if (entry && typeof entry.test_command === 'string') return entry.test_command;
  return '';
}

// finish 测试超时秒数：命令行 > 任务记录 > 平台配置；无配置返回 0（不限时）
function effectiveTestTimeout(task) {
  const fromTask = task ? Number.parseInt(task.test_timeout, 10) : Number.NaN;
  if (Number.isFinite(fromTask) && fromTask > 0) return fromTask;
  const entry = CONFIG.platforms && task ? CONFIG.platforms[task.platform] : null;
  const fromPlatform = entry ? Number.parseInt(entry.test_timeout, 10) : Number.NaN;
  return Number.isFinite(fromPlatform) && fromPlatform > 0 ? fromPlatform : 0;
}

function parseTimeoutArg(raw) {
  if (raw === undefined || raw === null || raw === '') return null;
  const n = Number.parseInt(raw, 10);
  if (!Number.isFinite(n) || n <= 0 || String(n) !== String(raw).trim()) {
    die(`--timeout 需要正整数秒：${raw}`);
  }
  return n;
}

// ============================ Task ID 自动命名 ============================

const ID_STOPWORDS = new Set([
  'a', 'an', 'the', 'of', 'for', 'and', 'to', 'in', 'on', 'with', 'my', 'our', 'new',
  'implement', 'implementation', 'add', 'create', 'build', 'support', 'update', 'upgrade',
  'fix', 'repair', 'patch', 'refactor', 'remove', 'delete', 'make', 'enable', 'allow',
  'introduce', 'improve', 'change', 'modify', 'migrate', 'handle', 'provide', 'write', 'writeup',
]);

function slugifyTitle(text) {
  const ascii = String(text)
    .normalize('NFKD')
    .replace(/[\u0300-\u036f]/g, '');
  let words = ascii
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, ' ')
    .trim()
    .split(/\s+/)
    .filter(Boolean);
  const meaningful = words.filter((w) => !ID_STOPWORDS.has(w));
  if (meaningful.length) words = meaningful;
  return words.slice(0, 6).join('-');
}

function nextTaskId(platformId, title) {
  let slug = slugifyTitle(title);
  if (slug.startsWith(`${platformId}-`)) slug = slug.slice(platformId.length + 1);
  const base = `${platformId}-${slug || 'task'}`;
  const taken = new Set(listTasks());
  for (let n = 1; n <= 999; n++) {
    const id = `${base}-${String(n).padStart(3, '0')}`;
    if (taken.has(id)) continue;
    return id;
  }
  die(`无法为 ${base} 生成 task id（序号已用尽）`);
}

// ============================ scope 重叠检测 ============================

function hasMagic(p) {
  return /[*?]/.test(p);
}

// glob 的非通配目录前缀（`src/auth/**` → `src/auth`；`src/*` → `src`）
function globPrefix(p) {
  const segs = p.replace(/\/+$/, '').split('/').filter(Boolean);
  const out = [];
  for (const s of segs) {
    if (/[*?]/.test(s)) break;
    out.push(s);
  }
  return out;
}

function segPrefix(a, b) {
  if (a.length === 0) return true;
  if (a.length > b.length) return false;
  return a.every((s, i) => s === b[i]);
}

function scopesOverlap(a, b) {
  if (a === b) return true;
  const ma = hasMagic(a);
  const mb = hasMagic(b);
  if (!ma && !mb) return false; // 两条精确路径且不同 → 不重叠
  const pa = globPrefix(a);
  const pb = globPrefix(b);
  return segPrefix(pa, pb) || segPrefix(pb, pa);
}

// 返回与该平台给定 scope 存在关联的未结束任务：{ task, overlap: true } 真实重叠 / false 无法判定。
// 只在同一 platform 内比较：不同端的 worktree 是不同项目根，同名路径语义不同，跨端比较只会误报。
function findScopeConflicts(platformId, allowed, selfId) {
  const found = [];
  for (const id of listTasks()) {
    if (id === selfId) continue;
    const t = readTask(id);
    if (t.platform !== platformId) continue;
    if (!OPEN_STATUSES.has(t.status)) continue;
    const other = t.allowed_paths;
    if (allowed.length === 0 || other.length === 0) {
      found.push({ task: t, overlap: false, reason: 'scope 未限定，无法判定重叠' });
      continue;
    }
    let hit = '';
    for (const a of allowed) {
      for (const b of other) {
        if (scopesOverlap(a, b)) {
          hit = `${a} ↔ ${b}`;
          break;
        }
      }
      if (hit) break;
    }
    if (hit) found.push({ task: t, overlap: true, reason: hit });
  }
  return found;
}

// ============================ 改动范围 ============================

function collectChanges(wt, baseCommit) {
  const set = new Set();
  const push = (text) => {
    for (const l of lines(text)) set.add(l);
  };
  push(git(['-C', wt, 'ls-files', '--others', '--exclude-standard']).stdout);
  push(git(['-C', wt, 'diff', '--name-only']).stdout);
  push(git(['-C', wt, 'diff', '--cached', '--name-only']).stdout);
  if (baseCommit && revParse(baseCommit)) {
    push(git(['-C', wt, 'diff', '--name-only', baseCommit, 'HEAD']).stdout);
  }
  return [...set];
}

function globToRegExp(pattern) {
  let re = '';
  for (let i = 0; i < pattern.length; i++) {
    const c = pattern[i];
    if (c === '*') {
      if (pattern[i + 1] === '*') {
        re += '.*';
        i++;
      } else {
        re += '[^/]*';
      }
    } else if (c === '?') {
      re += '[^/]';
    } else if ('\\^$.|+()[]{}'.includes(c)) {
      re += `\\${c}`;
    } else {
      re += c;
    }
  }
  return new RegExp(`^${re}$`);
}

function matchAllowed(pattern, p) {
  if (pattern === '**') return true;
  if (globToRegExp(pattern).test(p)) return true;
  return globToRegExp(`${pattern}/**`).test(p);
}

function scopeUnexpected(allowed, changed) {
  if (allowed.length === 0) return [];
  return changed.filter((p) => !allowed.some((pat) => matchAllowed(pat, p)));
}

function allowedBlock(allowed, indent = '  ') {
  if (allowed.length === 0) return `${indent}（未限定：allowed_paths 为空 = 不检查范围）`;
  return allowed.map((a) => `${indent}${a}`).join('\n');
}

// ============================ TASK.md（任务上下文） ============================

function taskContextPath(worktree) {
  return path.join(worktree, '.agents', 'TASK.md');
}

// .agents/TASK.md 属任务动态上下文：写进 git common dir 的 info/exclude，不进业务提交
function ensureTaskContextExcluded() {
  const infoDir = path.join(gitCommonDir(), 'info');
  const file = path.join(infoDir, 'exclude');
  const marker = '.agents/TASK.md';
  const current = isFile(file) ? fs.readFileSync(file, 'utf8') : '';
  if (current.split('\n').some((l) => l.trim() === marker)) return;
  fs.mkdirSync(infoDir, { recursive: true });
  const header = '# agentctl：任务 worktree 内的当前任务上下文（动态状态，不进业务提交）\n';
  const next = current.endsWith('\n') || current === '' ? `${current}${header}${marker}\n` : `${current}\n${header}${marker}\n`;
  fs.writeFileSync(file, next);
}

function taskContextContent(task) {
  const reqs = task.requirements.length ? task.requirements : [task.title];
  const others = buildPlatforms()
    .filter((r) => r.id !== task.platform && r.worktree)
    .map((r) => `  - ${r.id}: ${r.worktree}${r.branch ? ` @ ${r.branch}` : ''}`);
  const scope =
    task.allowed_paths.length > 0
      ? `Allowed paths:\n${task.allowed_paths.map((p) => `- ${p}`).join('\n')}`
      : 'Allowed paths: 未限定（提交前必须用 `agentctl task check` 校验实际改动，不得触碰无关模块）';
  return `# Current Task

Task ID: ${task.id}
Platform: ${task.platform}
Agent: ${task.agent}
Base Branch: ${task.base_branch}
Task Branch: ${task.task_branch}
Worktree: ${task.worktree}
Status: ${task.status}
Created: ${task.created_at}

## Objective

${task.objective || task.title}

## Requirements

${reqs.map((r) => `- ${r}`).join('\n')}

## Scope

${scope}

## Restrictions

- 只在本任务 Scope 内改动；越界改动即使有用也不提交。
- 不要修改其他平台 / 其他 worktree：
${others.length ? others.join('\n') : '  - （本次仅注册了一个平台）'}
- 不要切换到其他 Task Worktree，也不要在平台 worktree 内开发。
- 不要 reset / checkout / discard 无关改动：禁 \`git reset --hard\`、\`git clean\`、\`git checkout -- .\`、\`git stash\`。
- 不要自行把任务分支并入平台分支（集成由 \`agentctl task integrate\` 在平台 worktree 内完成）。

## Completion Criteria

- 相关测试通过（\`agentctl task finish\` 会按平台 test_command 校验）。
- \`git diff\` 复核过（\`agentctl task diff ${task.id}\`）。
- 无越界文件（\`agentctl task check ${task.id}\` 通过）。
- 改动已提交在任务分支 \`${task.task_branch}\`。
- 不并入平台分支，等待 Root Coordinator 执行 merge-check / integrate。

## Commands

- agentctl task check ${task.id}
- agentctl task diff ${task.id} --stat
- agentctl task finish ${task.id}
- agentctl task show ${task.id}
`;
}

function writeTaskContext(task) {
  ensureTaskContextExcluded();
  const file = taskContextPath(task.worktree);
  fs.mkdirSync(path.dirname(file), { recursive: true });
  const tmp = `${file}.tmp.${process.pid}`;
  fs.writeFileSync(tmp, taskContextContent(task));
  fs.renameSync(tmp, file);
  return file;
}

// ============================ AgentRunner ============================
// 只做「发现 + 构造启动命令 + 启动」，不重新实现任何 agent 自身能力。
// 内置模板来自本机 CLI 的 --help 实测；未实测的 CLI 必须由 .agents/config/agents.json 声明，
// 不猜测参数（猜错会把 agent 引到错误的目录 / 错误的会话）。

const BUILTIN_RUNNERS = {
  omp: {
    name: 'omp',
    command: 'omp',
    note: 'omp v18.2.5 实测：--cwd=<dir> 指定工作目录，-p/--print 非交互处理 prompt 后退出，--auto-approve 跳过工具批准（非交互自动化必需）',
    build: (ctx) => ({ command: 'omp', args: ['--cwd', ctx.worktree, '-p', '--auto-approve', ctx.prompt] }),
  },
  opencode: {
    name: 'opencode',
    command: 'opencode',
    note: 'opencode 实测：`opencode run [message..]` 非交互执行，--dir 指定运行目录',
    build: (ctx) => ({ command: 'opencode', args: ['run', '--dir', ctx.worktree, ctx.prompt] }),
  },
  codex: {
    name: 'codex',
    command: 'codex',
    note: '本机未安装，参数未实测；如需自动启动，在 .agents/config/agents.json 声明 { command, args }',
    build: null,
  },
  claude: {
    name: 'claude',
    command: 'claude',
    note: '本机未安装，参数未实测；如需自动启动，在 .agents/config/agents.json 声明 { command, args }',
    build: null,
  },
};

function whichCommand(cmd) {
  if (!cmd) return '';
  if (cmd.includes(path.sep)) return isFile(cmd) ? cmd : '';
  const dirs = (process.env.PATH || '').split(path.delimiter).filter(Boolean);
  const exts = process.platform === 'win32' ? (process.env.PATHEXT || '.EXE;.CMD;.BAT').split(';') : [''];
  for (const d of dirs) {
    for (const ext of exts) {
      const p = path.join(d, `${cmd}${ext}`);
      if (isFile(p)) return p;
    }
  }
  return '';
}

function runnerFor(agentName) {
  const declared = AGENT_CONFIG && typeof AGENT_CONFIG[agentName] === 'object' && AGENT_CONFIG[agentName] ? AGENT_CONFIG[agentName] : null;
  const builtin = BUILTIN_RUNNERS[agentName] || null;
  const command = (declared && typeof declared.command === 'string' && declared.command) || (builtin && builtin.command) || agentName;
  const argsTemplate = declared && Array.isArray(declared.args) ? declared.args.filter((a) => typeof a === 'string') : null;
  const path_ = whichCommand(command);
  return {
    name: agentName,
    command,
    path: path_,
    detected: Boolean(path_),
    provider: declared ? 'project-config' : builtin ? 'builtin' : 'unknown',
    note: builtin ? builtin.note : '未内置该 agent 的启动模板：请在 .agents/config/agents.json 声明 { command, args }',
    build(ctx) {
      if (argsTemplate) {
        return {
          command,
          args: argsTemplate.map((a) => a.replaceAll('{worktree}', ctx.worktree).replaceAll('{prompt}', ctx.prompt)),
        };
      }
      if (builtin && builtin.build) return builtin.build(ctx);
      return null;
    },
  };
}

function taskPrompt(task) {
  return [
    `你是本任务的 Worker，工作目录是 ${task.worktree}（任务分支 ${task.task_branch}）。`,
    `先读 ${taskContextPath(task.worktree)}（当前任务上下文），再开始实现。`,
    `需求：${task.objective || task.title}`,
    task.requirements.length ? `要求：\n${task.requirements.map((r) => `- ${r}`).join('\n')}` : '',
    task.allowed_paths.length ? `只允许改动：${task.allowed_paths.join(', ')}` : '',
    `完成后在任务 worktree 内提交，并运行 agentctl task finish ${task.id}（不要并入平台分支）。`,
  ]
    .filter(Boolean)
    .join('\n');
}

function buildRunnerCommand(task) {
  const runner = runnerFor(task.agent);
  if (!runner.detected) {
    return { ok: false, runner, reason: `未检测到可执行文件：${runner.command}` };
  }
  const built = runner.build({ worktree: task.worktree, prompt: taskPrompt(task) });
  if (!built) return { ok: false, runner, reason: runner.note };
  return { ok: true, runner, command: built.command, args: built.args };
}

function cmdAgentList(argv) {
  parseFlags(argv);
  const names = [...new Set([...Object.keys(BUILTIN_RUNNERS), ...Object.keys(AGENT_CONFIG)])];
  const rows = names.map((n) => {
    const r = runnerFor(n);
    return { agent: n, detected: r.detected, path: r.path, provider: r.provider, note: r.note };
  });
  if (JSON_OUT) {
    note(JSON.stringify({ agents: rows }, null, 2));
    return;
  }
  for (const r of rows) {
    note(`${r.agent}: ${r.detected ? 'detected' : 'not found'}${r.path ? `（${r.path}）` : ''}　[${r.provider}]`);
    note(`  ${r.note}`);
  }
}

// ============================ 输出表格 ============================

function printTable(headers, rows) {
  const all = [headers, ...rows];
  const widths = headers.map((_, c) => Math.max(...all.map((r) => String(r[c] ?? '').length)));
  for (const r of all) {
    note(r.map((cell, c) => String(cell ?? '').padEnd(widths[c] + 2)).join('').trimEnd());
  }
}

// ============================ 参数解析 ============================

let JSON_OUT = false;

function parseFlags(argv, { value = [], bool = [] } = {}) {
  const valueSet = new Set(value);
  const boolSet = new Set(bool);
  const vals = {};
  const flags = new Set();
  const positional = [];
  for (let i = 0; i < argv.length; i++) {
    const a = argv[i];
    if (a === '--') {
      positional.push(...argv.slice(i + 1));
      break;
    }
    if (!a.startsWith('--')) {
      positional.push(a);
      continue;
    }
    let key = a;
    let inline = null;
    const eq = a.indexOf('=');
    if (eq !== -1) {
      key = a.slice(0, eq);
      inline = a.slice(eq + 1);
    }
    if (valueSet.has(key)) {
      if (inline !== null) {
        vals[key] = inline;
      } else {
        if (i + 1 >= argv.length) die(`${key} 需要参数`);
        vals[key] = argv[++i];
      }
    } else if (boolSet.has(key)) {
      if (inline !== null) die(`${key} 不接受参数值`);
      flags.add(key);
    } else {
      usageError(`未知参数：${a}`);
    }
  }
  return { vals, flags, positional };
}

function splitList(raw) {
  return [
    ...new Set(
      String(raw || '')
        .split(/[;\n]/)
        .map((s) => s.trim())
        .filter(Boolean),
    ),
  ];
}

function parseAllowedPaths(raw) {
  const out = [];
  for (const item of splitList(raw)) {
    for (const p of item.split(',')) {
      const v = p.trim();
      if (v) out.push(v);
    }
  }
  return [...new Set(out)];
}

// ============================ init ============================

// 项目内一键初始化：由 git worktree list 探测平台并生成 platforms.json，
// 确保 .gitignore 排除运行时状态。幂等：已存在的配置一律不覆盖。
function cmdInit(argv) {
  parseFlags(argv);
  const created = [];
  const skipped = [];

  // 1. .gitignore：排除任务注册表与运行时状态
  const giPath = path.join(ROOT, '.gitignore');
  const gi = isFile(giPath) ? fs.readFileSync(giPath, 'utf8') : '';
  const giLines = new Set(gi.split('\n').map((l) => l.trim()));
  const need = ['.agents/tasks/', '.agents/state/'];
  const missing = need.filter((e) => !giLines.has(e) && !giLines.has(`/${e}`));
  if (missing.length > 0) {
    let next = gi;
    if (next !== '' && !next.endsWith('\n')) next += '\n';
    next += '# agentctl 运行时状态（任务注册表与临时产物，不入库）\n';
    next += `${missing.map((e) => `/${e}`).join('\n')}\n`;
    fs.writeFileSync(giPath, next);
    created.push(`.gitignore（追加 ${missing.map((e) => `/${e}`).join('、')}）`);
  }

  // 2. 平台 registry：探测生成；用户手工维护的已有配置绝不覆盖
  const detected = detectPlatforms();
  const registered = [];
  if (isFile(CONFIG_FILE)) {
    skipped.push(`${relToRoot(CONFIG_FILE)}（已存在，不覆盖；调整平台请手工编辑，或删除后重跑 init）`);
  } else {
    const platforms = {};
    const used = new Set();
    for (const d of detected) {
      let id = path.basename(d.path);
      let n = 2;
      while (used.has(id)) id = `${path.basename(d.path)}-${n++}`;
      used.add(id);
      platforms[id] = { worktree: relToRoot(d.path), branch: d.branch };
      registered.push({ id, worktree: relToRoot(d.path), branch: d.branch });
    }
    writeJsonAtomic(CONFIG_FILE, { platforms });
    created.push(`${relToRoot(CONFIG_FILE)}（登记 ${registered.length} 个探测平台）`);
  }

  if (JSON_OUT) {
    note(JSON.stringify({ initialized: true, created, skipped, platforms: registered.map((r) => r.id) }, null, 2));
    return;
  }

  note('agentctl init');
  note('');
  for (const c of created) note(`已生成：${c}`);
  for (const s of skipped) note(`跳过：${s}`);
  if (created.length === 0 && skipped.length === 0) note('没有需要初始化的内容（.gitignore 已含排除项，平台配置已存在）。');
  note('');
  if (skipped.length > 0) {
    note('平台配置已存在：agentctl platform list 查看当前 registry，或 agentctl doctor 自检。');
  } else if (registered.length === 0) {
    note('未探测到平台 worktree（当前只有主 checkout）。建议先建一个平台 worktree 作为集成边界：');
    note('  git worktree add <目录> -b <集成分支>    # 例：git worktree add wt/main -b feature/main');
    note('然后在 .agents/config/platforms.json 里声明该平台，或重跑 agentctl init 自动登记。');
  } else {
    note('已登记平台（可在 platforms.json 里补 aliases / test_command）：');
    printTable(['PLATFORM', 'BRANCH', 'WORKTREE'], registered.map((r) => [r.id, r.branch, r.worktree]));
    note('');
    note('下一步：');
    note(`  agentctl task create --platform <id> --agent <omp|opencode|…> --title '…' --allowed-paths '<globs>'`);
  }
  note('');
  note('自检：agentctl doctor');
}

